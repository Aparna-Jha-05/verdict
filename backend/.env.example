# AI Pipe token (OpenAI-compatible gateway). Required for extraction.
AIPIPE_TOKEN=your_aipipe_token_here

# Optional overrides — confirm live model names from AI Pipe's model list (§13).
# AIPIPE_BASE=https://aipipe.org
# AIPIPE_CHAT_ROUTE=/openrouter/v1/chat/completions
# AIPIPE_VISION_MODEL=openai/gpt-4o-mini
# AIPIPE_ESCALATION_MODEL=openai/gpt-4o

# CORS: comma-separated allowed origins (your Vercel URL). "*" for local dev.
CORS_ORIGINS=*

# Optional: tuning
# DEDUP_SIM_THRESHOLD=0.90
